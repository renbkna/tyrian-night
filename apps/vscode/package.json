{
  "name": "tyrian-night",
  "displayName": "Tyrian Night",
  "description": "Tyrian Night color theme family with opt-in Island UI",
  "version": "3.0.0",
  "type": "module",
  "publisher": "renbkna",
  "icon": "assets/icon.png",
  "files": [
    "LICENSE",
    "README.md",
    "island/tyrian-night.css",
    "island/tyrian-nocturne.css",
    "island/tyrian-pastel.css",
    "island/tyrian-abyss.css",
    "island/tyrian-dawn.css",
    "island/tyrian-night-old.css",
    "assets/icon.png",
    "out/extension.js",
    "out/islandCli.js",
    "themes/tyrian-night.json",
    "themes/tyrian-nocturne.json",
    "themes/tyrian-pastel.json",
    "themes/tyrian-abyss.json",
    "themes/tyrian-dawn.json",
    "themes/tyrian-night-old.json"
  ],
  "engines": {
    "vscode": "^1.118.0",
    "node": ">=22.19.0"
  },
  "categories": [
    "Themes"
  ],
  "extensionKind": [
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/renbkna/tyrian-night.git",
    "directory": "apps/vscode"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Tyrian Night",
        "uiTheme": "vs-dark",
        "path": "./themes/tyrian-night.json"
      },
      {
        "label": "Tyrian Nocturne",
        "uiTheme": "vs-dark",
        "path": "./themes/tyrian-nocturne.json"
      },
      {
        "label": "Tyrian Pastel",
        "uiTheme": "vs-dark",
        "path": "./themes/tyrian-pastel.json"
      },
      {
        "label": "Tyrian Abyss",
        "uiTheme": "vs-dark",
        "path": "./themes/tyrian-abyss.json"
      },
      {
        "label": "Tyrian Dawn",
        "uiTheme": "vs",
        "path": "./themes/tyrian-dawn.json"
      },
      {
        "label": "Tyrian Night Old",
        "uiTheme": "vs-dark",
        "path": "./themes/tyrian-night-old.json"
      }
    ],
    "commands": [
      {
        "command": "tyrianNight.applyIslandUi",
        "title": "Apply Island UI",
        "category": "Tyrian Night"
      },
      {
        "command": "tyrianNight.repairIslandUi",
        "title": "Repair Island UI",
        "category": "Tyrian Night"
      },
      {
        "command": "tyrianNight.restoreClassicUi",
        "title": "Restore Classic UI",
        "category": "Tyrian Night"
      },
      {
        "command": "tyrianNight.doctorIslandUi",
        "title": "Doctor Island UI",
        "category": "Tyrian Night"
      }
    ]
  },
  "scripts": {
    "bundle": "node -e \"require('node:fs').rmSync('out', { recursive: true, force: true })\" && bun build --target=node --format=esm --outdir=out --sourcemap=none --external=vscode --minify src/extension.ts src/islandCli.ts",
    "watch": "bun run bundle -- --watch",
    "package:artifact": "node -e \"require('node:fs').mkdirSync('../../dist', { recursive: true })\" && vsce package --no-dependencies --out ../../dist/tyrian-night.vsix"
  },
  "devDependencies": {
    "@types/vscode": "^1.118.0",
    "@vscode/vsce": "^3.9.1"
  }
}
