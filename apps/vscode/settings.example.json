{
  "breadcrumbs.enabled": true,
  "window.commandCenter": true,
  "window.customTitleBarVisibility": "auto",
  "window.density.editorTabHeight": "default",
  "window.titleBarStyle": "custom",
  "workbench.colorTheme": "Tyrian Night",
  "workbench.editor.decorations.badges": true,
  "workbench.editor.decorations.colors": true,
  "workbench.editor.editorActionsLocation": "titleBar",
  "workbench.editor.empty.hint": "hidden",
  "workbench.editor.labelFormat": "default",
  "workbench.editor.limit.enabled": true,
  "workbench.editor.limit.value": 10,
  "workbench.list.smoothScrolling": true,
  "workbench.reduceMotion": "off",
  "workbench.startupEditor": "none",
  "workbench.tree.indent": 16,
  "workbench.tree.renderIndentGuides": "always",
  "zenMode.centerLayout": true,
  "zenMode.fullScreen": true,
  "zenMode.hideActivityBar": true,
  "zenMode.hideLineNumbers": false,
  "zenMode.hideStatusBar": false,
  "zenMode.restore": true,
  "debug.console.fontFamily": "'Monaspace Neon var', monospace",
  "editor.fontFamily": "'Monaspace Neon var', 'JetBrains Mono', 'IBM Plex Mono', monospace",
  "editor.fontLigatures": "'calt', 'ss01', 'ss02', 'ss03', 'ss04', 'ss05', 'ss06', 'ss07', 'ss08', 'ss09', 'ss10', 'liga', dlig",
  "editor.fontSize": 15,
  "editor.fontVariations": "'wdth' 95, 'slnt' 0, 'GRAD' -50",
  "editor.fontWeight": "450",
  "editor.inlayHints.fontFamily": "'Monaspace Radon var', 'Monaspace Neon var', 'IBM Plex Mono', 'SF Mono', monospace",
  "editor.inlayHints.fontSize": 12,
  "editor.letterSpacing": 0,
  "editor.lineHeight": 1.5,
  "markdown.preview.fontFamily": "'iA Writer Quattro', 'Inter Variable', Georgia, serif",
  "scm.inputFontFamily": "'Inter Variable', 'Inter', -apple-system, system-ui, sans-serif",
  "editor.bracketPairColorization.enabled": true,
  "editor.bracketPairColorization.independentColorPoolPerBracketType": true,
  "editor.cursorBlinking": "smooth",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.cursorStyle": "line",
  "editor.cursorSurroundingLines": 6,
  "editor.cursorSurroundingLinesStyle": "all",
  "editor.cursorWidth": 2,
  "editor.foldingHighlight": true,
  "editor.glyphMargin": true,
  "editor.guides.bracketPairs": "active",
  "editor.guides.bracketPairsHorizontal": "active",
  "editor.guides.highlightActiveIndentation": true,
  "editor.guides.indentation": true,
  "editor.inlayHints.padding": true,
  "editor.lineNumbers": "on",
  "editor.matchBrackets": "near",
  "editor.minimap.enabled": true,
  "editor.minimap.maxColumn": 80,
  "editor.minimap.renderCharacters": false,
  "editor.minimap.scale": 2,
  "editor.minimap.showSlider": "always",
  "editor.occurrencesHighlight": "multiFile",
  "editor.padding.bottom": 18,
  "editor.padding.top": 18,
  "editor.renderLineHighlight": "line",
  "editor.renderWhitespace": "selection",
  "editor.rulers": [120],
  "editor.scrollbar.horizontalScrollbarSize": 14,
  "editor.scrollbar.verticalScrollbarSize": 14,
  "editor.selectionHighlight": true,
  "editor.smoothScrolling": true,
  "editor.stickyScroll.enabled": true,
  "editor.stickyScroll.maxLineCount": 3,
  "editor.stickyScroll.scrollWithEditor": true,
  "editor.unicodeHighlight.ambiguousCharacters": true,
  "editor.unicodeHighlight.invisibleCharacters": true,
  "editor.wordWrap": "wordWrapColumn",
  "editor.wordWrapColumn": 120,
  "editor.wrappingStrategy": "advanced",
  "indentRainbow.excludedLanguages": ["svelte", "rust", "typescript", "javascript", "plaintext"],
  "comments.openView": "never",
  "diffEditor.codeLens": true,
  "diffEditor.ignoreTrimWhitespace": false,
  "diffEditor.renderIndicators": true,
  "diffEditor.renderSideBySide": true,
  "editor.acceptSuggestionOnEnter": "smart",
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit",
    "source.organizeImports.biome": "explicit"
  },
  "editor.detectIndentation": true,
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "editor.formatOnSaveMode": "file",
  "editor.formatOnType": false,
  "editor.gotoLocation.multipleDefinitions": "goto",
  "editor.gotoLocation.multipleImplementations": "goto",
  "editor.hover.above": true,
  "editor.hover.delay": 350,
  "editor.hover.enabled": "on",
  "editor.hover.sticky": true,
  "editor.indentSize": "tabSize",
  "editor.inlineSuggest.enabled": true,
  "editor.insertSpaces": true,
  "editor.linkedEditing": true,
  "editor.mouseWheelZoom": true,
  "editor.quickSuggestions": {
    "other": true,
    "comments": false,
    "strings": false
  },
  "editor.rename.enablePreview": true,
  "editor.snippetSuggestions": "top",
  "editor.suggest.insertMode": "replace",
  "editor.suggest.preview": true,
  "editor.suggest.shareSuggestSelections": true,
  "editor.suggest.showStatusBar": true,
  "editor.suggestFontSize": 14,
  "editor.suggestLineHeight": 22,
  "editor.tabSize": 4,
  "editor.wordBasedSuggestions": "matchingDocuments",
  "problems.decorations.enabled": true,
  "terminal.external.linuxExec": "ghostty",
  "terminal.integrated.defaultProfile.linux": "fish",
  "terminal.integrated.profiles.linux": {
    "fish": {
      "path": "/usr/bin/fish",
      "icon": "terminal-linux",
      "color": "terminal.ansiMagenta"
    },
    "bash": {
      "path": "/bin/bash",
      "icon": "terminal-linux"
    }
  },
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.cursorWidth": 2,
  "terminal.integrated.fastScrollSensitivity": 5,
  "terminal.integrated.fontFamily": "'Monaspace Neon var', 'IBM Plex Mono', monospace",
  "terminal.integrated.fontSize": 15,
  "terminal.integrated.fontWeight": "400",
  "terminal.integrated.gpuAcceleration": "auto",
  "terminal.integrated.letterSpacing": 0.2,
  "terminal.integrated.lineHeight": 1.4,
  "terminal.integrated.mouseWheelZoom": true,
  "terminal.integrated.smoothScrolling": true,
  "terminal.integrated.stickyScroll.enabled": true,
  "explorer.autoReveal": "focusNoScroll",
  "explorer.compactFolders": false,
  "explorer.confirmDelete": true,
  "explorer.confirmDragAndDrop": true,
  "explorer.decorations.badges": true,
  "explorer.decorations.colors": true,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "package.json": "package-lock.json, bun.lockb, pnpm-lock.yaml, yarn.lock, .npmrc",
    "*.ts": "${capture}.js, ${capture}.d.ts, ${capture}.test.ts",
    ".env": "*.env, .env.*",
    "next.config.*": "postcss.config.*, tailwind.config.*, .eslintrc.*, tsconfig.*, next-env.d.ts",
    "svelte.config.*": "vite.config.*, tailwind.config.*, postcss.config.*, tsconfig.*, .prettierrc*",
    "+page.svelte": "+page.server.ts, +page.ts, +page.server.js, +page.js",
    "+layout.svelte": "+layout.server.ts, +layout.ts, +layout.server.js, +layout.js"
  },
  "files.associations": {
    "*.css": "tailwindcss"
  },
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 2000,
  "files.exclude": {
    "**/.git": true,
    "**/.gitignore": false,
    "**/.gitattributes": true,
    "**/.gitkeep": true,
    "**/.claude": true,
    "**/.jules": true,
    "**/.opencode": true,
    "**/.vscode": true,
    "**/.vs": true,
    "**/.idea": true,
    "**/.editorconfig": true,
    "**/.directory": true,
    "**/.vscodeignore": true,
    "**/.eslintrc.*": true,
    "**/.prettierrc*": true,
    "**/.prettierignore": true,
    "**/.npmrc": true,
    "**/.husky": true,
    "**/.storybook": true,
    "**/.ruff_cache": true,
    "**/.pytest_cache": true,
    "**/.venv": true,
    "**/.coverage": true,
    "**/.hypothesis": true,
    "**/.python-version": true,
    "**/.pre-commit-config.yaml": true,
    "**/.bandit.yml": true,
    "**/.readthedocs.yaml": true,
    "**/.cargo": true,
    "**/.gradle": true,
    "**/.kotlin": true,
    "**/.classpath": true,
    "**/.project": true,
    "**/.settings": true,
    "**/.factorypath": true,
    "**/.dart_tool": true,
    "**/.flutter-plugins-dependencies": true,
    "**/.metadata": true,
    "**/.firebaserc": true,
    "**/.firebase": true,
    "**/.dockerignore": true,
    "**/.markdownlint.json": true,
    "**/.biomeignore": true,
    "**/.mise.toml": true,
    "**/.asv": true,
    "**/.reference": true
  },
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/*/**": true,
    "**/.next/**": true,
    "**/.svelte-kit/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/target/**": true,
    "**/bin/**": true,
    "**/obj/**": true,
    "**/.venv/**": true,
    "**/__pycache__/**": true,
    ".turbo": true
  },
  "search.exclude": {
    "**/*.code-search": true
  },
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "git.openRepositoryInParentFolders": "never",
  "git.postCommitCommand": "none",
  "git.mergeEditor": true,
  "scm.diffDecorations": "all",
  "scm.diffDecorationsGutterVisibility": "hover",
  "[csharp]": {
    "editor.defaultFormatter": "ms-dotnettools.csharpier"
  },
  "[css]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[tailwindcss]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[html]": {
    "editor.defaultFormatter": "vscode.html-language-features"
  },
  "[java]": {
    "editor.tabSize": 4
  },
  "[javascript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[json]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[markdown]": {
    "editor.defaultFormatter": "DavidAnson.vscode-markdownlint"
  },
  "[svelte]": {
    "editor.defaultFormatter": "svelte.svelte-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "biomejs.biome"
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml"
  },
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "java.completion.enabled": false,
  "java.format.settings.url": "https://raw.githubusercontent.com/google/styleguide/gh-pages/eclipse-java-google-style.xml",
  "json.schemaDownload.enable": true,
  "json.schemaDownload.trustedDomains": {
    "https://schemastore.azurewebsites.net/": true,
    "https://raw.githubusercontent.com/microsoft/vscode/": true,
    "https://raw.githubusercontent.com/devcontainers/spec/": true,
    "https://www.schemastore.org/": true,
    "https://json.schemastore.org/": true,
    "https://json-schema.org/": true,
    "https://developer.microsoft.com/json-schemas/": true,
    "https://models.dev/model-schema.json": true,
    "https://opencode.ai": true,
    "https://raw.githubusercontent.com/": true,
    "https://schema.tauri.app": true,
    "https://biomejs.dev/schemas": true,
    "https://zed.dev/schema/themes/v0.2.0.json": true,
    "https://biomejs.dev": true
  },
  "npm.packageManager": "bun",
  "rust-analyzer.files.excludeDirs": [
    "node_modules",
    "target",
    ".git",
    "assets",
    "dist",
    ".venv",
    "__pycache__"
  ],
  "svelte.enable-ts-plugin": true,
  "js/ts.experimental.useTsgo": true,
  "js/ts.suggest.paths": false,
  "js/ts.updateImportsOnFileMove.enabled": "always",
  "oxc.lint.run": "onType",
  "ruff.nativeServer": "on",
  "ruff.lint.enable": true,
  "ruff.organizeImports": true,
  "ruff.fixAll": true,
  "ty.diagnosticMode": "workspace",
  "ty.inlayHints.variableTypes": false,
  "ty.completions.autoImport": true,
  "chat.agent.maxRequests": 50,
  "extensions.closeExtensionDetailsOnViewChange": true,
  "extensions.ignoreRecommendations": false,
  "markdown-preview-enhanced.codeBlockTheme": "github-dark.css",
  "markdown-preview-enhanced.enablePreviewZenMode": true,
  "markdown-preview-enhanced.previewTheme": "atom-dark.css",
  "markdown-preview-enhanced.revealjsTheme": "black.css",
  "sonarlint.automaticAnalysis": true,
  "sonarlint.focusOnNewCode": false,
  "sonarlint.ideLabsEnabled": true,
  "editor.accessibilitySupport": "off",
  "editor.largeFileOptimizations": true,
  "http.systemCertificatesNode": true,
  "security.workspace.trust.banner": "never",
  "security.workspace.trust.startupPrompt": "once",
  "telemetry.editStats.enabled": false,
  "telemetry.feedback.enabled": false,
  "chat.viewSessions.orientation": "stacked",
  "chat.tips.enabled": false,
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false
  }
}
