  "semanticTokenColors": {
    "*.declaration": {
      "bold": true
    },
    "variable": {
      "foreground": "#B8B4BB"
    },
    "parameter": {
      "foreground": "#B96C92"
    },
    "variable.local": {
      "foreground": "#B8B4BB"
    },
    "variable.defaultLibrary": {
      "foreground": "#B96C92"
    },
    "variable.readonly": {
      "foreground": "#B96C92"
    },
    "property.readonly": {
      "foreground": "#B96C92"
    },
    "function": {
      "foreground": "#829FD0"
    },
    "function.defaultLibrary": {
      "foreground": "#829FD0"
    },
    "method": {
      "foreground": "#829FD0"
    },
    "class": {
      "foreground": "#7481DA"
    },
    "class.defaultLibrary": {
      "foreground": "#7481DA"
    },
    "interface": {
      "foreground": "#7481DA"
    },
    "type": {
      "foreground": "#7481DA"
    },
    "typeParameter": {
      "foreground": "#7481DA"
    },
    "namespace": {
      "foreground": "#7481DA"
    },
    "enum": {
      "foreground": "#7481DA"
    },
    "enumMember": {
      "foreground": "#B96C92"
    },
    "property": {
      "foreground": "#B8B4BB"
    },
    "decorator": {
      "foreground": "#7481DA"
    },
    "macro": {
      "foreground": "#7481DA"
    },
    "regexp": {
      "foreground": "#AF8442"
    },
    "keyword": {
      "foreground": "#956DBE"
    },
    "operator": {
      "foreground": "#956DBE"
    },
    "string": {
      "foreground": "#6D936A"
    },
    "number": {
      "foreground": "#B96C92"
    },
    "comment": {
      "foreground": "#7E7981"
    },
    "*.readonly": {
      "foreground": "#B96C92"
    },
    "*.deprecated": {
      "foreground": "#B96C92",
      "fontStyle": "strikethrough"
    },
    "*.documentation": {
      "foreground": "#89838D"
    },
    "constructor": {
      "foreground": "#7481DA"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7E7981",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#89838D",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.operator",
        "keyword.control",
        "keyword.other.import",
        "keyword.control.import",
        "entity.name.tag",
        "entity.name.tag.js",
        "entity.name.tag.css",
        "meta.import"
      ],
      "settings": {
        "foreground": "#956DBE"
      }
    },
    {
      "scope": [
        "meta.type.annotation",
        "meta.annotation",
        "entity.name.type.annotation"
      ],
      "settings": {
        "foreground": "#7481DA",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.type.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.type.interface",
        "entity.name.interface",
        "support.type",
        "support.class",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#7481DA"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "entity.name.method",
        "variable.function"
      ],
      "settings": {
        "foreground": "#829FD0"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "meta.parameter",
        "entity.other.attribute-name",
        "meta.attribute",
        "support.type.property-name.json",
        "constant.character.escape",
        "string.regexp constant.character.escape"
      ],
      "settings": {
        "foreground": "#B96C92"
      }
    },
    {
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#B96C92",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#6D936A"
      }
    },
    {
      "scope": [
        "constant.language.null",
        "constant.language.nil",
        "constant.language.none"
      ],
      "settings": {
        "foreground": "#7E7981"
      }
    },
    {
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#A17FA7"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.character",
        "constant.other",
        "keyword.other.unit",
        "variable.other.enummember",
        "variable.other.constant",
        "entity.name.constant",
        "support.constant",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#B96C92"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.other.property",
        "meta.object-literal.key",
        "support.variable",
        "support.constant.property-value.css"
      ],
      "settings": {
        "foreground": "#B8B4BB"
      }
    },
    {
      "scope": [
        "support.type.property-name.css",
        "entity.other.attribute-name.class.css"
      ],
      "settings": {
        "foreground": "#B8B4BB"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#827D85"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#AF8442"
      }
    },
    {
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#7481DA"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#956DBE",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
