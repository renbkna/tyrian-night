      "foreground": "#D5B07C"
    },
    "keyword": {
      "foreground": "#C7A1DF"
    },
    "operator": {
      "foreground": "#C7A1DF"
    },
    "string": {
      "foreground": "#97C09B"
    },
    "number": {
      "foreground": "#D69AB8"
