  "semanticTokenColors": {
    "*.declaration": {
      "bold": true
    },
    "variable": {
      "foreground": "#BDB4C2"
    },
    "parameter": {
      "foreground": "#CA7288"
    },
    "variable.local": {
      "foreground": "#BDB4C2"
    },
    "variable.defaultLibrary": {
      "foreground": "#CA7288"
    },
    "variable.readonly": {
      "foreground": "#CA7288"
    },
    "property.readonly": {
      "foreground": "#CA7288"
    },
    "function": {
      "foreground": "#819DCE"
    },
    "function.defaultLibrary": {
      "foreground": "#819DCE"
    },
    "method": {
      "foreground": "#819DCE"
    },
    "class": {
      "foreground": "#6A8F8D"
    },
    "class.defaultLibrary": {
      "foreground": "#6A8F8D"
    },
    "interface": {
      "foreground": "#6A8F8D"
    },
    "type": {
      "foreground": "#6A8F8D"
    },
    "typeParameter": {
      "foreground": "#6A8F8D"
    },
    "namespace": {
      "foreground": "#6A8F8D"
    },
    "enum": {
      "foreground": "#6A8F8D"
    },
    "enumMember": {
      "foreground": "#CA7288"
    },
    "property": {
      "foreground": "#BDB4C2"
    },
    "decorator": {
      "foreground": "#6A8F8D"
    },
    "macro": {
      "foreground": "#6A8F8D"
    },
    "regexp": {
      "foreground": "#AF7D5A"
    },
    "keyword": {
      "foreground": "#8D7CC0"
    },
    "operator": {
      "foreground": "#8D7CC0"
    },
    "string": {
      "foreground": "#529875"
    },
    "number": {
      "foreground": "#CA7288"
    },
    "comment": {
      "foreground": "#918599"
    },
    "*.readonly": {
      "foreground": "#CA7288"
    },
    "*.deprecated": {
      "foreground": "#CA7288",
      "fontStyle": "strikethrough"
    },
    "*.documentation": {
      "foreground": "#A397AD"
    },
    "constructor": {
      "foreground": "#6A8F8D"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#918599",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#A397AD",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.operator",
        "keyword.control",
        "keyword.other.import",
        "keyword.control.import",
        "entity.name.tag",
        "entity.name.tag.js",
        "entity.name.tag.css",
        "meta.import"
      ],
      "settings": {
        "foreground": "#8D7CC0"
      }
    },
    {
      "scope": [
        "meta.type.annotation",
        "meta.annotation",
        "entity.name.type.annotation"
      ],
      "settings": {
        "foreground": "#6A8F8D",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.type.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.type.interface",
        "entity.name.interface",
        "support.type",
        "support.class",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#6A8F8D"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "entity.name.method",
        "variable.function"
      ],
      "settings": {
        "foreground": "#819DCE"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "meta.parameter",
        "entity.other.attribute-name",
        "meta.attribute",
        "support.type.property-name.json",
        "constant.character.escape",
        "string.regexp constant.character.escape"
      ],
      "settings": {
        "foreground": "#CA7288"
      }
    },
    {
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#CA7288",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#529875"
      }
    },
    {
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#AA829E"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.character",
        "constant.other",
        "keyword.other.unit",
        "variable.other.enummember",
        "variable.other.constant",
        "entity.name.constant",
        "support.constant",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#CA7288"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.other.property",
        "meta.object-literal.key",
        "support.variable",
        "support.constant.property-value.css"
      ],
      "settings": {
        "foreground": "#BDB4C2"
      }
    },
    {
      "scope": [
        "support.type.property-name.css",
        "entity.other.attribute-name.class.css"
      ],
      "settings": {
        "foreground": "#BDB4C2"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#93889B"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#AF7D5A"
      }
    },
    {
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#6A8F8D"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#8D7CC0",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#BDB4C2",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#B18AC5",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#819DCE"
      }
    },
    {
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#6A8F8D"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#529875",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "diff.deleted"
      ],
      "settings": {
        "foreground": "#DD7950"
      }
    },
    {
      "scope": [
        "markup.inserted",
        "diff.inserted"
      ],
      "settings": {
        "foreground": "#59A68C"
      }
    },
    {
      "scope": [
        "markup.changed",
        "diff.changed"
      ],
      "settings": {
        "foreground": "#7D9FC9"
      }
    },
    {
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "foreground": "#7D9FC9",
        "fontStyle": "strikethrough"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#DD7950"
      }
    },
    {
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#CA7288",
        "fontStyle": "strikethrough"
      }
    }
  ]
}
