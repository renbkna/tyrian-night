      "foreground": "#A5A3E2"
    },
    "type": {
      "foreground": "#A5A3E2"
    },
    "typeParameter": {
      "foreground": "#A5A3E2"
    },
    "namespace": {
      "foreground": "#A5A3E2"
    },
    "enum": {
      "foreground": "#A5A3E2"
    },
    "enumMember": {
      "foreground": "#D69AB8"
    },
    "property": {
      "foreground": "#DDD6E5"
    },
