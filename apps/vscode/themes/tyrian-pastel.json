      "foreground": "#D69AB8"
    },
    "property.readonly": {
      "foreground": "#D69AB8"
    },
    "function": {
      "foreground": "#93AFE2"
    },
    "function.defaultLibrary": {
      "foreground": "#93AFE2"
    },
    "method": {
      "foreground": "#93AFE2"
    },
    "class": {
      "foreground": "#A5A3E2"
    },
    "class.defaultLibrary": {
      "foreground": "#A5A3E2"
    },
