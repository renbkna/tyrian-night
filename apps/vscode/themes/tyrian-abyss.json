  "semanticTokenColors": {
    "*.declaration": {
      "bold": true
    },
    "variable": {
      "foreground": "#DED6E9"
    },
    "parameter": {
      "foreground": "#D561AE"
    },
    "variable.local": {
      "foreground": "#DED6E9"
    },
    "variable.defaultLibrary": {
      "foreground": "#D561AE"
    },
    "variable.readonly": {
      "foreground": "#D561AE"
    },
    "property.readonly": {
      "foreground": "#D561AE"
    },
    "function": {
      "foreground": "#73A2FD"
    },
    "function.defaultLibrary": {
      "foreground": "#73A2FD"
    },
    "method": {
      "foreground": "#73A2FD"
    },
    "class": {
      "foreground": "#7D6CFB"
    },
    "class.defaultLibrary": {
      "foreground": "#7D6CFB"
    },
    "interface": {
      "foreground": "#7D6CFB"
    },
    "type": {
      "foreground": "#7D6CFB"
    },
    "typeParameter": {
      "foreground": "#7D6CFB"
    },
    "namespace": {
      "foreground": "#7D6CFB"
    },
    "enum": {
      "foreground": "#7D6CFB"
    },
    "enumMember": {
      "foreground": "#D561AE"
    },
    "property": {
      "foreground": "#DED6E9"
    },
    "decorator": {
      "foreground": "#7D6CFB"
    },
    "macro": {
      "foreground": "#7D6CFB"
    },
    "regexp": {
      "foreground": "#C68C28"
    },
    "keyword": {
      "foreground": "#D83BF0"
    },
    "operator": {
      "foreground": "#D83BF0"
    },
    "string": {
      "foreground": "#58B763"
    },
    "number": {
      "foreground": "#D561AE"
    },
    "comment": {
      "foreground": "#85769E"
    },
    "*.readonly": {
      "foreground": "#D561AE"
    },
    "*.deprecated": {
      "foreground": "#D561AE",
      "fontStyle": "strikethrough"
    },
    "*.documentation": {
      "foreground": "#9F90BD"
    },
    "constructor": {
      "foreground": "#7D6CFB"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#85769E",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#9F90BD",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.operator",
        "keyword.control",
        "keyword.other.import",
        "keyword.control.import",
        "entity.name.tag",
        "entity.name.tag.js",
        "entity.name.tag.css",
        "meta.import"
      ],
      "settings": {
        "foreground": "#D83BF0"
      }
    },
    {
      "scope": [
        "meta.type.annotation",
        "meta.annotation",
        "entity.name.type.annotation"
      ],
      "settings": {
        "foreground": "#7D6CFB",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.type.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.type.interface",
        "entity.name.interface",
        "support.type",
        "support.class",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#7D6CFB"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "entity.name.method",
        "variable.function"
      ],
      "settings": {
        "foreground": "#73A2FD"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "meta.parameter",
        "entity.other.attribute-name",
        "meta.attribute",
        "support.type.property-name.json",
        "constant.character.escape",
        "string.regexp constant.character.escape"
      ],
      "settings": {
        "foreground": "#D561AE"
      }
    },
    {
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#D561AE",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#58B763"
      }
    },
    {
      "scope": [
        "constant.language.null",
        "constant.language.nil",
        "constant.language.none"
      ],
      "settings": {
        "foreground": "#84779B"
      }
    },
    {
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#D384D2"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.character",
        "constant.other",
        "keyword.other.unit",
        "variable.other.enummember",
        "variable.other.constant",
        "entity.name.constant",
        "support.constant",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#D561AE"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.other.property",
        "meta.object-literal.key",
        "support.variable",
        "support.constant.property-value.css"
      ],
      "settings": {
        "foreground": "#DED6E9"
      }
    },
    {
      "scope": [
        "support.type.property-name.css",
        "entity.other.attribute-name.class.css"
      ],
      "settings": {
        "foreground": "#DED6E9"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#9381AF"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#C68C28"
      }
    },
    {
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#7D6CFB"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#D83BF0",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#DED6E9",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#D579F9",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#73A2FD"
      }
    },
    {
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#C09DED"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#58B763",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "diff.deleted"
      ],
      "settings": {
        "foreground": "#F0636F"
      }
    },
    {
      "scope": [
        "markup.inserted",
        "diff.inserted"
      ],
      "settings": {
        "foreground": "#59A961"
      }
    },
    {
      "scope": [
        "markup.changed",
        "diff.changed"
      ],
      "settings": {
        "foreground": "#5698EC"
      }
    },
    {
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "foreground": "#5698EC",
        "fontStyle": "strikethrough"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#F0636F"
      }
    },
    {
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#D561AE",
        "fontStyle": "strikethrough"
      }
    }
  ]
}
