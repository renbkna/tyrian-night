    "variable": {
      "foreground": "#DED7EE"
    },
    "parameter": {
      "foreground": "#BE7DD0"
    },
    "variable.local": {
      "foreground": "#DED7EE"
    },
    "variable.defaultLibrary": {
      "foreground": "#BE7DD0"
    },
    "variable.readonly": {
      "foreground": "#BE7DD0"
    },
    "property.readonly": {
      "foreground": "#BE7DD0"
    },
    "function": {
      "foreground": "#D7586E"
    },
    "function.defaultLibrary": {
      "foreground": "#D7586E"
    },
    "method": {
      "foreground": "#D7586E"
    },
    "class": {
      "foreground": "#4A7DFF"
    },
    "class.defaultLibrary": {
      "foreground": "#4A7DFF"
    },
    "interface": {
      "foreground": "#4A7DFF"
    },
    "type": {
      "foreground": "#4A7DFF"
    },
    "typeParameter": {
      "foreground": "#4A7DFF"
    },
    "namespace": {
      "foreground": "#4A7DFF"
    },
    "enum": {
      "foreground": "#4A7DFF"
    },
    "enumMember": {
      "foreground": "#BE7DD0"
    },
    "property": {
      "foreground": "#DED7EE"
    },
    "decorator": {
      "foreground": "#4A7DFF"
    },
    "macro": {
      "foreground": "#4A7DFF"
    },
    "regexp": {
      "foreground": "#C764FF"
    },
    "keyword": {
      "foreground": "#8652FF"
    },
    "operator": {
      "foreground": "#8652FF"
    },
    "string": {
      "foreground": "#39A96B"
    },
    "number": {
      "foreground": "#BE7DD0"
    },
    "comment": {
      "foreground": "#8E82B0"
    },
    "*.readonly": {
      "foreground": "#BE7DD0"
    },
    "*.deprecated": {
      "foreground": "#BE7DD0",
      "fontStyle": "strikethrough"
    },
    "*.documentation": {
      "foreground": "#A199C0"
    },
    "constructor": {
      "foreground": "#4A7DFF"
    }
