  "semanticTokenColors": {
    "*.declaration": {
      "bold": true
    },
    "variable": {
      "foreground": "#DBD2EF"
    },
    "parameter": {
      "foreground": "#D680A3"
    },
    "variable.local": {
      "foreground": "#DBD2EF"
    },
    "variable.defaultLibrary": {
      "foreground": "#D680A3"
    },
    "variable.readonly": {
      "foreground": "#D680A3"
    },
    "property.readonly": {
      "foreground": "#D680A3"
    },
    "function": {
      "foreground": "#8BABE1"
    },
    "function.defaultLibrary": {
      "foreground": "#8BABE1"
    },
    "method": {
      "foreground": "#8BABE1"
    },
    "class": {
      "foreground": "#52A9AF"
    },
    "class.defaultLibrary": {
      "foreground": "#52A9AF"
    },
    "interface": {
      "foreground": "#52A9AF"
    },
    "type": {
      "foreground": "#52A9AF"
    },
    "typeParameter": {
      "foreground": "#52A9AF"
    },
    "namespace": {
      "foreground": "#52A9AF"
    },
    "enum": {
      "foreground": "#52A9AF"
    },
    "enumMember": {
      "foreground": "#D680A3"
    },
    "property": {
      "foreground": "#DBD2EF"
    },
    "decorator": {
      "foreground": "#52A9AF"
    },
    "macro": {
      "foreground": "#52A9AF"
    },
    "regexp": {
      "foreground": "#C39726"
    },
    "keyword": {
      "foreground": "#A957D8"
    },
    "operator": {
      "foreground": "#A957D8"
    },
    "string": {
      "foreground": "#60A361"
    },
    "number": {
      "foreground": "#D680A3"
    },
    "comment": {
      "foreground": "#8085B3"
    },
    "*.readonly": {
      "foreground": "#D680A3"
    },
    "*.deprecated": {
      "foreground": "#D680A3",
      "fontStyle": "strikethrough"
    },
    "*.documentation": {
      "foreground": "#9C9BD2"
    },
    "constructor": {
      "foreground": "#52A9AF"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8085B3",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#9C9BD2",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.operator",
        "keyword.control",
        "keyword.other.import",
        "keyword.control.import",
        "entity.name.tag",
        "entity.name.tag.js",
        "entity.name.tag.css",
        "meta.import"
      ],
      "settings": {
        "foreground": "#A957D8"
      }
    },
    {
      "scope": [
        "meta.type.annotation",
        "meta.annotation",
        "entity.name.type.annotation"
      ],
      "settings": {
        "foreground": "#52A9AF",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.type.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.type.interface",
        "entity.name.interface",
        "support.type",
        "support.class",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#52A9AF"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "entity.name.method",
        "variable.function"
      ],
      "settings": {
        "foreground": "#8BABE1"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "meta.parameter",
        "entity.other.attribute-name",
        "meta.attribute",
        "support.type.property-name.json",
        "constant.character.escape",
        "string.regexp constant.character.escape"
      ],
      "settings": {
        "foreground": "#D680A3"
      }
    },
    {
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#D680A3",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#60A361"
      }
    },
    {
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#CA99D6"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.character",
        "constant.other",
        "keyword.other.unit",
        "variable.other.enummember",
        "variable.other.constant",
        "entity.name.constant",
        "support.constant",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#D680A3"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.other.property",
        "meta.object-literal.key",
        "support.variable",
        "support.constant.property-value.css"
      ],
      "settings": {
        "foreground": "#DBD2EF"
      }
    },
    {
      "scope": [
        "support.type.property-name.css",
        "entity.other.attribute-name.class.css"
      ],
      "settings": {
        "foreground": "#DBD2EF"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#8B8AB6"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#C39726"
      }
    },
    {
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#52A9AF"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#A957D8",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#DBD2EF",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#D190FF",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#8BABE1"
      }
    },
    {
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#52A9AF"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#60A361",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "diff.deleted"
      ],
      "settings": {
        "foreground": "#F66B71"
      }
    },
    {
      "scope": [
        "markup.inserted",
        "diff.inserted"
      ],
      "settings": {
        "foreground": "#54A859"
      }
    },
    {
      "scope": [
        "markup.changed",
        "diff.changed"
      ],
      "settings": {
        "foreground": "#53A0FF"
      }
    },
    {
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "foreground": "#53A0FF",
        "fontStyle": "strikethrough"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#F66B71"
      }
    },
    {
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#D680A3",
        "fontStyle": "strikethrough"
      }
    }
  ]
}
