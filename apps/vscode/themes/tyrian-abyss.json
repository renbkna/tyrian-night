  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8E82B0",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#A199C0",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.operator",
        "keyword.control",
        "keyword.other.import",
        "keyword.control.import",
        "entity.name.tag",
        "entity.name.tag.js",
        "entity.name.tag.css",
        "meta.import"
      ],
      "settings": {
        "foreground": "#8652FF"
      }
    },
    {
      "scope": [
        "meta.type.annotation",
        "meta.annotation",
        "entity.name.type.annotation"
      ],
      "settings": {
        "foreground": "#4A7DFF",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.type.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.type.interface",
        "entity.name.interface",
        "support.type",
        "support.class",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#4A7DFF"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "entity.name.method",
        "variable.function"
      ],
      "settings": {
        "foreground": "#D7586E"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "meta.parameter",
        "entity.other.attribute-name",
        "meta.attribute",
        "support.type.property-name.json",
        "constant.character.escape",
        "string.regexp constant.character.escape"
      ],
      "settings": {
        "foreground": "#BE7DD0"
      }
    },
    {
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#BE7DD0",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#39A96B"
      }
    },
    {
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#AAA4D8"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.character",
        "constant.other",
        "keyword.other.unit",
        "variable.other.enummember",
        "variable.other.constant",
        "entity.name.constant",
        "support.constant",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#BE7DD0"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.other.property",
        "meta.object-literal.key",
        "support.variable",
        "support.constant.property-value.css"
      ],
      "settings": {
        "foreground": "#DED7EE"
      }
    },
    {
      "scope": [
        "support.type.property-name.css",
        "entity.other.attribute-name.class.css"
      ],
      "settings": {
        "foreground": "#DED7EE"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#A69ABC"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#C764FF"
      }
    },
    {
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#4A7DFF"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#8652FF",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#DED7EE",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#C764FF",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#D7586E"
      }
    },
    {
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#4A7DFF"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#39A96B",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "diff.deleted"
      ],
      "settings": {
        "foreground": "#E05270"
      }
    },
    {
      "scope": [
        "markup.inserted",
        "diff.inserted"
      ],
      "settings": {
        "foreground": "#39A96B"
      }
    },
    {
      "scope": [
        "markup.changed",
        "diff.changed"
      ],
      "settings": {
        "foreground": "#4A7DFF"
      }
    },
    {
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "foreground": "#4A7DFF",
        "fontStyle": "strikethrough"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#E05270"
      }
    },
    {
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#BE7DD0",
        "fontStyle": "strikethrough"
      }
    }
  ]
