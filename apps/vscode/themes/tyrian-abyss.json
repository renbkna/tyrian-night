        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "diff.deleted"
      ],
      "settings": {
        "foreground": "#FC8C92"
      }
    },
    {
      "scope": [
        "markup.inserted",
        "diff.inserted"
      ],
      "settings": {
