  "semanticTokenColors": {
    "*.declaration": {
      "bold": true
    },
    "variable": {
      "foreground": "#D8D1E6"
    },
    "parameter": {
      "foreground": "#D95495"
    },
    "variable.local": {
      "foreground": "#D8D1E6"
    },
    "variable.defaultLibrary": {
      "foreground": "#D95495"
    },
    "variable.readonly": {
      "foreground": "#D95495"
    },
    "property.readonly": {
      "foreground": "#D95495"
    },
    "function": {
      "foreground": "#77A0F0"
    },
    "function.defaultLibrary": {
      "foreground": "#77A0F0"
    },
    "method": {
      "foreground": "#77A0F0"
    },
    "class": {
      "foreground": "#7E73ED"
    },
    "class.defaultLibrary": {
      "foreground": "#7E73ED"
    },
    "interface": {
      "foreground": "#7E73ED"
    },
    "type": {
      "foreground": "#7E73ED"
    },
    "typeParameter": {
      "foreground": "#7E73ED"
    },
    "namespace": {
      "foreground": "#7E73ED"
    },
    "enum": {
      "foreground": "#7E73ED"
    },
    "enumMember": {
      "foreground": "#D95495"
    },
    "property": {
      "foreground": "#D8D1E6"
    },
    "decorator": {
      "foreground": "#7E73ED"
    },
    "macro": {
      "foreground": "#7E73ED"
    },
    "regexp": {
      "foreground": "#B7822B"
    },
    "keyword": {
      "foreground": "#C251D4"
    },
    "operator": {
      "foreground": "#C251D4"
    },
    "string": {
      "foreground": "#62A168"
    },
    "number": {
      "foreground": "#D95495"
    },
    "comment": {
      "foreground": "#7D789C"
    },
    "*.readonly": {
      "foreground": "#D95495"
    },
    "*.deprecated": {
      "foreground": "#D95495",
      "fontStyle": "strikethrough"
    },
    "*.documentation": {
      "foreground": "#9790BC"
    },
    "constructor": {
      "foreground": "#7E73ED"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7D789C",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#9790BC",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.operator",
        "keyword.control",
        "keyword.other.import",
        "keyword.control.import",
        "entity.name.tag",
        "entity.name.tag.js",
        "entity.name.tag.css",
        "meta.import"
      ],
      "settings": {
        "foreground": "#C251D4"
      }
    },
    {
      "scope": [
        "meta.type.annotation",
        "meta.annotation",
        "entity.name.type.annotation"
      ],
      "settings": {
        "foreground": "#7E73ED",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.type.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.type.interface",
        "entity.name.interface",
        "support.type",
        "support.class",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#7E73ED"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "entity.name.method",
        "variable.function"
      ],
      "settings": {
        "foreground": "#77A0F0"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "meta.parameter",
        "entity.other.attribute-name",
        "meta.attribute",
        "support.type.property-name.json",
        "constant.character.escape",
        "string.regexp constant.character.escape"
      ],
      "settings": {
        "foreground": "#D95495"
      }
    },
    {
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#D95495",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#62A168"
      }
    },
    {
      "scope": [
        "constant.language.null",
        "constant.language.nil",
        "constant.language.none"
      ],
      "settings": {
        "foreground": "#7D789C"
      }
    },
    {
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#C888C8"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.character",
        "constant.other",
        "keyword.other.unit",
        "variable.other.enummember",
        "variable.other.constant",
        "entity.name.constant",
        "support.constant",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#D95495"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.other.property",
        "meta.object-literal.key",
        "support.variable",
        "support.constant.property-value.css"
      ],
      "settings": {
        "foreground": "#D8D1E6"
      }
    },
    {
      "scope": [
        "support.type.property-name.css",
        "entity.other.attribute-name.class.css"
      ],
      "settings": {
        "foreground": "#D8D1E6"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#8881AB"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#B7822B"
      }
    },
    {
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#7E73ED"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#C251D4",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#D8D1E6",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#CE7EEC",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#77A0F0"
      }
    },
    {
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#B99BE8"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#62A168",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "diff.deleted"
      ],
      "settings": {
        "foreground": "#ED6A75"
      }
    },
    {
      "scope": [
        "markup.inserted",
        "diff.inserted"
      ],
      "settings": {
        "foreground": "#57A461"
      }
    },
    {
      "scope": [
        "markup.changed",
        "diff.changed"
      ],
      "settings": {
        "foreground": "#5797E6"
      }
    },
    {
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "foreground": "#5797E6",
        "fontStyle": "strikethrough"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#ED6A75"
      }
    },
    {
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#D95495",
        "fontStyle": "strikethrough"
      }
    }
  ]
