  "semanticTokenColors": {
    "*.declaration": {
      "bold": true
    },
    "variable": {
      "foreground": "#B8B3BE"
    },
    "parameter": {
      "foreground": "#A46A8F"
    },
    "variable.local": {
      "foreground": "#B8B3BE"
    },
    "variable.defaultLibrary": {
      "foreground": "#A46A8F"
    },
    "variable.readonly": {
      "foreground": "#A46A8F"
    },
    "property.readonly": {
      "foreground": "#A46A8F"
    },
    "function": {
      "foreground": "#738EC1"
    },
    "function.defaultLibrary": {
      "foreground": "#738EC1"
    },
    "method": {
      "foreground": "#738EC1"
    },
    "class": {
      "foreground": "#7874C5"
    },
    "class.defaultLibrary": {
      "foreground": "#7874C5"
    },
    "interface": {
      "foreground": "#7874C5"
    },
    "type": {
      "foreground": "#7874C5"
    },
    "typeParameter": {
      "foreground": "#7874C5"
    },
    "namespace": {
      "foreground": "#7874C5"
    },
    "enum": {
      "foreground": "#7874C5"
    },
    "enumMember": {
      "foreground": "#A46A8F"
    },
    "property": {
      "foreground": "#B8B3BE"
    },
    "decorator": {
      "foreground": "#7874C5"
    },
    "macro": {
      "foreground": "#7874C5"
    },
    "regexp": {
      "foreground": "#997643"
    },
    "keyword": {
      "foreground": "#9B68A3"
    },
    "operator": {
      "foreground": "#9B68A3"
    },
    "string": {
      "foreground": "#5F8662"
    },
    "number": {
      "foreground": "#A46A8F"
    },
    "comment": {
      "foreground": "#827D8B"
    },
    "*.readonly": {
      "foreground": "#A46A8F"
    },
    "*.deprecated": {
      "foreground": "#A46A8F",
      "fontStyle": "strikethrough"
    },
    "*.documentation": {
      "foreground": "#878293"
    },
    "constructor": {
      "foreground": "#7874C5"
    }
