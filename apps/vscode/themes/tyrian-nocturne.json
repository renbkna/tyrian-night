  "semanticTokenColors": {
    "*.declaration": {
      "bold": true
    },
    "variable": {
      "foreground": "#D4CCE5"
    },
    "parameter": {
      "foreground": "#DD86C1"
    },
    "variable.local": {
      "foreground": "#D4CCE5"
    },
    "variable.defaultLibrary": {
      "foreground": "#DD86C1"
    },
    "variable.readonly": {
      "foreground": "#DD86C1"
    },
    "property.readonly": {
      "foreground": "#DD86C1"
    },
    "function": {
      "foreground": "#16BBBC"
    },
    "function.defaultLibrary": {
      "foreground": "#16BBBC"
    },
    "method": {
      "foreground": "#16BBBC"
    },
    "class": {
      "foreground": "#78ABFF"
    },
    "class.defaultLibrary": {
      "foreground": "#78ABFF"
    },
    "interface": {
      "foreground": "#78ABFF"
    },
    "type": {
      "foreground": "#78ABFF"
    },
    "typeParameter": {
      "foreground": "#78ABFF"
    },
    "namespace": {
      "foreground": "#78ABFF"
    },
    "enum": {
      "foreground": "#78ABFF"
    },
    "enumMember": {
      "foreground": "#DD86C1"
    },
    "property": {
      "foreground": "#D4CCE5"
    },
    "decorator": {
      "foreground": "#78ABFF"
    },
    "macro": {
      "foreground": "#78ABFF"
    },
    "regexp": {
      "foreground": "#CDA448"
    },
    "keyword": {
      "foreground": "#AB6FFF"
    },
    "operator": {
      "foreground": "#AB6FFF"
    },
    "string": {
      "foreground": "#60A563"
    },
    "number": {
      "foreground": "#DD86C1"
    },
    "comment": {
      "foreground": "#8286AA"
    },
    "*.readonly": {
      "foreground": "#DD86C1"
    },
    "*.deprecated": {
      "foreground": "#DD86C1",
      "fontStyle": "strikethrough"
    },
    "*.documentation": {
      "foreground": "#9A9AC3"
    },
    "constructor": {
      "foreground": "#78ABFF"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#8286AA",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#9A9AC3",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.operator",
        "keyword.control",
        "keyword.other.import",
        "keyword.control.import",
        "entity.name.tag",
        "entity.name.tag.js",
        "entity.name.tag.css",
        "meta.import"
      ],
      "settings": {
        "foreground": "#AB6FFF"
      }
    },
    {
      "scope": [
        "meta.type.annotation",
        "meta.annotation",
        "entity.name.type.annotation"
      ],
      "settings": {
        "foreground": "#78ABFF",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.type.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.type.interface",
        "entity.name.interface",
        "support.type",
        "support.class",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#78ABFF"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "entity.name.method",
        "variable.function"
      ],
      "settings": {
        "foreground": "#16BBBC"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "meta.parameter",
        "entity.other.attribute-name",
        "meta.attribute",
        "support.type.property-name.json",
        "constant.character.escape",
        "string.regexp constant.character.escape"
      ],
      "settings": {
        "foreground": "#DD86C1"
      }
    },
    {
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#DD86C1",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#60A563"
      }
    },
    {
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#C29BCB"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.character",
        "constant.other",
        "keyword.other.unit",
        "variable.other.enummember",
        "variable.other.constant",
        "entity.name.constant",
        "support.constant",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#DD86C1"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.other.property",
        "meta.object-literal.key",
        "support.variable",
        "support.constant.property-value.css"
      ],
      "settings": {
        "foreground": "#D4CCE5"
      }
    },
    {
      "scope": [
        "support.type.property-name.css",
        "entity.other.attribute-name.class.css"
      ],
      "settings": {
        "foreground": "#D4CCE5"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#8585A7"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#CDA448"
      }
    },
    {
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#78ABFF"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#AB6FFF",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#D4CCE5",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#CD8FF9",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#16BBBC"
      }
    },
    {
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#78ABFF"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#60A563",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "diff.deleted"
      ],
      "settings": {
        "foreground": "#E8777A"
      }
    },
    {
      "scope": [
        "markup.inserted",
        "diff.inserted"
      ],
      "settings": {
        "foreground": "#60A563"
      }
    },
    {
      "scope": [
        "markup.changed",
        "diff.changed"
      ],
      "settings": {
        "foreground": "#59A0F9"
      }
    },
    {
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "foreground": "#59A0F9",
        "fontStyle": "strikethrough"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#E8777A"
      }
    },
    {
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#DD86C1",
        "fontStyle": "strikethrough"
      }
    }
  ]
