        "meta.function-call",
        "entity.name.method",
        "variable.function"
      ],
      "settings": {
        "foreground": "#6890E4"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "meta.parameter",
        "entity.other.attribute-name",
        "meta.attribute",
        "support.type.property-name.json",
        "constant.character.escape",
        "string.regexp constant.character.escape"
