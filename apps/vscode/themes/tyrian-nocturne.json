  "semanticTokenColors": {
    "*.declaration": {
      "bold": true
    },
    "variable": {
      "foreground": "#B7AFBE"
    },
    "parameter": {
      "foreground": "#C4588C"
    },
    "variable.local": {
      "foreground": "#B7AFBE"
    },
    "variable.defaultLibrary": {
      "foreground": "#C4588C"
    },
    "variable.readonly": {
      "foreground": "#C4588C"
    },
    "property.readonly": {
      "foreground": "#C4588C"
    },
    "function": {
      "foreground": "#6890E4"
    },
    "function.defaultLibrary": {
      "foreground": "#6890E4"
    },
    "method": {
      "foreground": "#6890E4"
    },
    "class": {
      "foreground": "#7879DB"
    },
    "class.defaultLibrary": {
      "foreground": "#7879DB"
    },
    "interface": {
      "foreground": "#7879DB"
    },
    "type": {
      "foreground": "#7879DB"
    },
    "typeParameter": {
      "foreground": "#7879DB"
    },
    "namespace": {
      "foreground": "#7879DB"
    },
    "enum": {
      "foreground": "#7879DB"
    },
    "enumMember": {
      "foreground": "#C4588C"
    },
    "property": {
      "foreground": "#B7AFBE"
    },
    "decorator": {
      "foreground": "#7879DB"
    },
    "macro": {
      "foreground": "#7879DB"
    },
    "regexp": {
      "foreground": "#AA773C"
    },
    "keyword": {
      "foreground": "#A961D0"
    },
    "operator": {
      "foreground": "#A961D0"
    },
    "string": {
      "foreground": "#5A944D"
    },
    "number": {
      "foreground": "#C4588C"
    },
    "comment": {
      "foreground": "#9068AD"
    },
    "*.readonly": {
      "foreground": "#C4588C"
    },
    "*.deprecated": {
      "foreground": "#C4588C",
      "fontStyle": "strikethrough"
    },
    "*.documentation": {
      "foreground": "#8F6DB1"
    },
    "constructor": {
      "foreground": "#7879DB"
    }
