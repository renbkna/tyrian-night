      "settings": {
        "foreground": "#CEC7D8"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.definition.tag",
        "keyword.operator",
