        "foreground": "#887F98"
      }
    },
    {
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#C58BC4"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.character",
        "constant.other",
        "keyword.other.unit",
