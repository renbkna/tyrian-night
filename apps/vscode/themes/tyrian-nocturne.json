      "foreground": "#D0C8DA"
    },
    "parameter": {
      "foreground": "#D25C94"
    },
    "variable.local": {
      "foreground": "#D0C8DA"
    },
    "variable.defaultLibrary": {
      "foreground": "#D25C94"
    },
    "variable.readonly": {
      "foreground": "#D25C94"
    },
    "property.readonly": {
      "foreground": "#D25C94"
    },
    "function": {
      "foreground": "#7BA1E8"
    },
    "function.defaultLibrary": {
      "foreground": "#7BA1E8"
    },
    "method": {
      "foreground": "#7BA1E8"
    },
    "class": {
      "foreground": "#7E76E3"
    },
    "class.defaultLibrary": {
      "foreground": "#7E76E3"
    },
    "interface": {
      "foreground": "#7E76E3"
    },
    "type": {
      "foreground": "#7E76E3"
    },
    "typeParameter": {
      "foreground": "#7E76E3"
    },
    "namespace": {
      "foreground": "#7E76E3"
    },
    "enum": {
      "foreground": "#7E76E3"
    },
    "enumMember": {
      "foreground": "#D25C94"
    },
    "property": {
      "foreground": "#D0C8DA"
    },
    "decorator": {
      "foreground": "#7E76E3"
    },
    "macro": {
      "foreground": "#7E76E3"
    },
    "regexp": {
      "foreground": "#B3843A"
    },
    "keyword": {
      "foreground": "#BD5ACD"
    },
    "operator": {
      "foreground": "#BD5ACD"
    },
    "string": {
      "foreground": "#689F6C"
    },
    "number": {
      "foreground": "#D25C94"
    },
    "comment": {
      "foreground": "#887F99"
    },
    "*.readonly": {
      "foreground": "#D25C94"
    },
    "*.deprecated": {
      "foreground": "#D25C94",
