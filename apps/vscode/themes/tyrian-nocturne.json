      "settings": {
        "foreground": "#C6A7EF"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#54C764",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "diff.deleted"
      ],
      "settings": {
        "foreground": "#FC8C92"
      }
    },
    {
      "scope": [
        "markup.inserted",
        "diff.inserted"
      ],
      "settings": {
        "foreground": "#649B68"
      }
    },
    {
      "scope": [
        "markup.changed",
        "diff.changed"
      ],
      "settings": {
        "foreground": "#6B99D5"
      }
    },
    {
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "foreground": "#6B99D5",
        "fontStyle": "strikethrough"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#FC8C92"
      }
    },
    {
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
