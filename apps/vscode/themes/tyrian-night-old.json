  "semanticTokenColors": {
    "*.declaration": {
      "bold": true
    },
    "variable": {
      "foreground": "#D0C8E0"
    },
    "parameter": {
      "foreground": "#C07AA8"
    },
    "variable.local": {
      "foreground": "#D0C8E0"
    },
    "variable.defaultLibrary": {
      "foreground": "#C07AA8"
    },
    "variable.readonly": {
      "foreground": "#C07AA8"
    },
    "property.readonly": {
      "foreground": "#C07AA8"
    },
    "function": {
      "foreground": "#3A9690"
    },
    "function.defaultLibrary": {
      "foreground": "#3A9690"
    },
    "method": {
      "foreground": "#3A9690"
    },
    "class": {
      "foreground": "#5A78C0"
    },
    "class.defaultLibrary": {
      "foreground": "#5A78C0"
    },
    "interface": {
      "foreground": "#5A78C0"
    },
    "type": {
      "foreground": "#5A78C0"
    },
    "typeParameter": {
      "foreground": "#5A78C0"
    },
    "namespace": {
      "foreground": "#5A78C0"
    },
    "enum": {
      "foreground": "#5A78C0"
    },
    "enumMember": {
      "foreground": "#C07AA8"
    },
    "property": {
      "foreground": "#D0C8E0"
    },
    "decorator": {
      "foreground": "#5A78C0"
    },
    "macro": {
      "foreground": "#5A78C0"
    },
    "regexp": {
      "foreground": "#AA7DD0"
    },
    "keyword": {
      "foreground": "#8B6ABD"
    },
    "operator": {
      "foreground": "#8B6ABD"
    },
    "string": {
      "foreground": "#489060"
    },
    "number": {
      "foreground": "#C07AA8"
    },
    "comment": {
      "foreground": "#7880A0"
    },
    "*.readonly": {
      "foreground": "#C07AA8"
    },
    "*.deprecated": {
      "foreground": "#C07AA8",
      "fontStyle": "strikethrough"
    },
    "*.documentation": {
      "foreground": "#8890B0"
    },
    "constructor": {
      "foreground": "#5A78C0"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#7880A0",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#8890B0",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.operator",
        "keyword.control",
        "keyword.other.import",
        "keyword.control.import",
        "entity.name.tag",
        "entity.name.tag.js",
        "entity.name.tag.css",
        "meta.import"
      ],
      "settings": {
        "foreground": "#8B6ABD"
      }
    },
    {
      "scope": [
        "meta.type.annotation",
        "meta.annotation",
        "entity.name.type.annotation"
      ],
      "settings": {
        "foreground": "#5A78C0",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.type.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.type.interface",
        "entity.name.interface",
        "support.type",
        "support.class",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#5A78C0"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "entity.name.method",
        "variable.function"
      ],
      "settings": {
        "foreground": "#3A9690"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "meta.parameter",
        "entity.other.attribute-name",
        "meta.attribute",
        "support.type.property-name.json",
        "constant.character.escape",
        "string.regexp constant.character.escape"
      ],
      "settings": {
        "foreground": "#C07AA8"
      }
    },
    {
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#C07AA8",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#489060"
      }
    },
    {
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#9A94BC"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.character",
        "constant.other",
        "keyword.other.unit",
        "variable.other.enummember",
        "variable.other.constant",
        "entity.name.constant",
        "support.constant",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#C07AA8"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.other.property",
        "meta.object-literal.key",
        "support.variable",
        "support.constant.property-value.css"
      ],
      "settings": {
        "foreground": "#D0C8E0"
      }
    },
    {
      "scope": [
        "support.type.property-name.css",
        "entity.other.attribute-name.class.css"
      ],
      "settings": {
        "foreground": "#D0C8E0"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#7D7595"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#AA7DD0"
      }
    },
    {
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#5A78C0"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#8B6ABD",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#D0C8E0",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#AA7DD0",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#3A9690"
      }
    },
    {
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#5A78C0"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#489060",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "diff.deleted"
      ],
      "settings": {
        "foreground": "#C06868"
      }
    },
    {
      "scope": [
        "markup.inserted",
        "diff.inserted"
      ],
      "settings": {
        "foreground": "#489060"
      }
    },
    {
      "scope": [
        "markup.changed",
        "diff.changed"
      ],
      "settings": {
        "foreground": "#5A78C0"
      }
    },
    {
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "foreground": "#5A78C0",
        "fontStyle": "strikethrough"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#C06868"
      }
    },
    {
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#C07AA8",
        "fontStyle": "strikethrough"
      }
    }
  ]
