  "semanticTokenColors": {
    "*.declaration": {
      "bold": true
    },
    "variable": {
      "foreground": "#2D2332"
    },
    "parameter": {
      "foreground": "#8F4968"
    },
    "variable.local": {
      "foreground": "#2D2332"
    },
    "variable.defaultLibrary": {
      "foreground": "#8F4968"
    },
    "variable.readonly": {
      "foreground": "#8F4968"
    },
    "property.readonly": {
      "foreground": "#8F4968"
    },
    "function": {
      "foreground": "#365C96"
    },
    "function.defaultLibrary": {
      "foreground": "#365C96"
    },
    "method": {
      "foreground": "#365C96"
    },
    "class": {
      "foreground": "#514DA0"
    },
    "class.defaultLibrary": {
      "foreground": "#514DA0"
    },
    "interface": {
      "foreground": "#514DA0"
    },
    "type": {
      "foreground": "#514DA0"
    },
    "typeParameter": {
      "foreground": "#514DA0"
    },
    "namespace": {
      "foreground": "#514DA0"
    },
    "enum": {
      "foreground": "#514DA0"
    },
    "enumMember": {
      "foreground": "#8F4968"
    },
    "property": {
      "foreground": "#2D2332"
    },
    "decorator": {
      "foreground": "#514DA0"
    },
    "macro": {
      "foreground": "#514DA0"
    },
    "regexp": {
      "foreground": "#7B5C24"
    },
    "keyword": {
      "foreground": "#7A4785"
    },
    "operator": {
      "foreground": "#7A4785"
    },
    "string": {
      "foreground": "#3F7243"
    },
    "number": {
      "foreground": "#8F4968"
    },
    "comment": {
      "foreground": "#63576A"
    },
    "*.readonly": {
      "foreground": "#8F4968"
    },
    "*.deprecated": {
      "foreground": "#8F4968",
      "fontStyle": "strikethrough"
    },
    "*.documentation": {
      "foreground": "#5A5062"
    },
    "constructor": {
      "foreground": "#514DA0"
    }
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#63576A",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#5A5062",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.operator",
        "keyword.control",
        "keyword.other.import",
        "keyword.control.import",
        "entity.name.tag",
        "entity.name.tag.js",
        "entity.name.tag.css",
        "meta.import"
      ],
      "settings": {
        "foreground": "#7A4785"
      }
    },
    {
      "scope": [
        "meta.type.annotation",
        "meta.annotation",
        "entity.name.type.annotation"
      ],
      "settings": {
        "foreground": "#514DA0",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.type.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.type.interface",
        "entity.name.interface",
        "support.type",
        "support.class",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#514DA0"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "entity.name.method",
        "variable.function"
      ],
      "settings": {
        "foreground": "#365C96"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "meta.parameter",
        "entity.other.attribute-name",
        "meta.attribute",
        "support.type.property-name.json",
        "constant.character.escape",
        "string.regexp constant.character.escape"
      ],
      "settings": {
        "foreground": "#8F4968"
      }
    },
    {
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#8F4968",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#3F7243"
      }
    },
    {
      "scope": [
        "constant.language.null",
        "constant.language.nil",
        "constant.language.none"
      ],
      "settings": {
        "foreground": "#6A5C6F"
      }
    },
    {
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#72486D"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.character",
        "constant.other",
        "keyword.other.unit",
        "variable.other.enummember",
        "variable.other.constant",
        "entity.name.constant",
        "support.constant",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#8F4968"
      }
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.other.property",
        "meta.object-literal.key",
        "support.variable",
        "support.constant.property-value.css"
      ],
      "settings": {
        "foreground": "#2D2332"
      }
    },
    {
      "scope": [
        "support.type.property-name.css",
        "entity.other.attribute-name.class.css"
      ],
      "settings": {
        "foreground": "#2D2332"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#5E5466"
      }
    },
    {
      "scope": [
        "string.regexp"
      ],
      "settings": {
        "foreground": "#7B5C24"
      }
    },
    {
      "scope": [
        "entity.name.function.decorator",
        "meta.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#514DA0"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#7A4785",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#2D2332",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#76418C",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw"
      ],
      "settings": {
        "foreground": "#365C96"
      }
    },
    {
      "scope": [
        "markup.underline.link"
      ],
      "settings": {
        "foreground": "#664E7C"
      }
    },
    {
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#3F7243",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.deleted",
        "diff.deleted"
      ],
      "settings": {
        "foreground": "#A0323C"
      }
    },
    {
      "scope": [
        "markup.inserted",
        "diff.inserted"
      ],
      "settings": {
        "foreground": "#2F6933"
      }
    },
    {
      "scope": [
        "markup.changed",
        "diff.changed"
      ],
      "settings": {
        "foreground": "#275D95"
      }
    },
    {
      "scope": [
        "markup.strikethrough"
      ],
      "settings": {
        "foreground": "#275D95",
        "fontStyle": "strikethrough"
      }
    },
    {
      "scope": [
        "invalid"
      ],
      "settings": {
        "foreground": "#A0323C"
      }
    },
    {
      "scope": [
        "invalid.deprecated"
      ],
      "settings": {
        "foreground": "#8F4968",
        "fontStyle": "strikethrough"
      }
    }
