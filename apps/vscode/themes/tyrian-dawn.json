  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#A69AAD",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation",
        "string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#A59AAE",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "keyword.control",
        "keyword.operator.expression.of"
      ],
      "settings": {
        "foreground": "#7E2A8F"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.other",
        "storage.type",
        "storage.modifier",
        "keyword.operator.expression",
        "keyword.operator.new",
        "keyword.operator.delete",
        "keyword.operator.cast",
        "keyword.operator.sizeof",
        "keyword.operator.instanceof",
        "keyword.operator.and",
        "keyword.operator.not",
        "keyword.operator.or",
        "keyword.operator.logical.python",
        "keyword.operator.logical.lua",
        "keyword.other.import",
        "keyword.control.import",
        "keyword.control.from",
        "keyword.control.export",
        "keyword.control.as",
        "keyword.control.default",
        "keyword.control.type",
        "keyword.control.at-rule",
        "keyword.control.directive",
        "entity.name.tag",
        "entity.name.tag.js",
        "entity.name.tag.css",
        "meta.import"
      ],
      "settings": {
        "foreground": "#A76BB5"
      }
    },
    {
      "scope": [
        "meta.type.annotation",
        "meta.annotation",
        "entity.name.type.annotation"
      ],
      "settings": {
        "foreground": "#605DB5",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.namespace",
        "entity.name.label",
        "support.type",
        "support.class",
        "support.class.component",
        "storage.type.built-in",
        "storage.type.boolean.go",
        "storage.type.byte.go",
        "storage.type.error.go",
        "storage.type.numeric.go",
        "storage.type.rune.go",
        "storage.type.string.go",
        "storage.type.uintptr.go"
      ],
      "settings": {
        "foreground": "#605DB5"
      }
    },
    {
      "scope": [
        "entity.name.type.class",
        "entity.name.type.interface",
        "entity.name.type.alias",
        "entity.name.type.enum",
        "entity.name.type.struct",
        "entity.name.type.trait",
        "entity.name.type.declaration",
        "entity.name.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.interface"
      ],
      "settings": {
        "foreground": "#605DB5",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "entity.name.method",
        "variable.function"
      ],
      "settings": {
        "foreground": "#1F5099"
      }
    },
    {
      "scope": [
        "meta.definition.function entity.name.function",
        "meta.definition.method entity.name.function",
        "meta.function.definition entity.name.function",
        "meta.function.python entity.name.function"
      ],
      "settings": {
        "foreground": "#1F5099",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "variable.parameter",
        "meta.parameter",
        "entity.other.attribute-name",
        "meta.attribute",
        "constant.character.escape",
        "string.regexp constant.character.escape",
