      ],
      "settings": {
        "foreground": "#9F4781"
      }
    },
    {
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#9F4781",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "string.template",
        "punctuation.definition.string",
        "storage.type.string.python"
      ],
      "settings": {
        "foreground": "#2D7536"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "keyword.other.unit",
        "storage.type.numeric.bigint",
