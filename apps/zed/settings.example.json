{
  "theme": {
    "mode": "dark",
    "light": "Tyrian Dawn",
    "dark": "Tyrian Night"
  },
  "icon_theme": {
    "mode": "light",
    "light": "Colored Zed Icons Theme Dark",
    "dark": "Colored Zed Icons Theme Dark"
  },
  "semantic_tokens": "off",
  "colorize_brackets": true,
  "current_line_highlight": "line",
  "show_whitespaces": "selection",
  "show_wrap_guides": false,
  "sticky_scroll": {
    "enabled": true
  },
  "minimap": {
    "show": "auto",
    "thumb": "always"
  },
  "gutter": {
    "min_line_number_digits": 3
  },
  "indent_guides": {
    "enabled": true,
    "line_width": 1,
    "active_line_width": 1,
    "coloring": "indent_aware",
    "background_coloring": "disabled"
  },
  "buffer_font_family": "Monaspace Neon",
  "buffer_font_size": 15,
  "buffer_font_weight": 450,
  "buffer_line_height": {
    "custom": 1.45
  },
  "buffer_font_features": {
    "calt": true,
    "liga": true,
    "dlig": true,
    "ss01": true,
    "ss02": true,
    "ss03": true,
    "ss04": true,
    "ss05": true,
    "ss06": true,
    "ss07": true,
    "ss08": true,
    "ss09": true,
    "ss10": true
  },
  "ui_font_family": ".ZedSans",
  "ui_font_size": 16,
  "ui_font_weight": 400,
  "terminal": {
    "font_family": "Monaspace Neon",
    "font_size": 8,
    "line_height": {
      "custom": 1.2
    },
    "cursor_shape": "bar",
    "blinking": "terminal_controlled",
    "minimum_contrast": 0
  },
  "soft_wrap": "bounded",
  "smooth_scroll": true,
  "preferred_line_length": 120,
  "tab_size": 4
}
