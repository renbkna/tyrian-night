{
  "ui_font_family": "Inter Variable",
  "ui_font_size": 16,
  "ui_font_weight": 400,
  "buffer_line_height": {
    "custom": 1.45
  },
  "buffer_font_size": 18,
  "buffer_font_weight": 300,
  "buffer_font_family": "Monaspace Neon",
  "disable_ai": true,
  "text_rendering_mode": "platform_default",
  "theme": {
    "mode": "dark",
    "light": "Tyrian Dawn",
    "dark": "Tyrian Nocturne"
  },
  "icon_theme": {
    "mode": "light",
    "light": "Colored Zed Icons Theme Dark",
    "dark": "Colored Zed Icons Theme Dark"
  },
  "semantic_tokens": "combined",
  "colorize_brackets": true,
  "show_whitespaces": "selection",
  "show_wrap_guides": false,
  "sticky_scroll": {
    "enabled": true
  },
  "minimap": {
    "show": "auto",
    "thumb": "always"
  },
  "gutter": {
    "min_line_number_digits": 3
  },
  "indent_guides": {
    "enabled": true,
    "line_width": 1,
    "active_line_width": 1,
    "coloring": "indent_aware"
  },
  "inlay_hints": {
    "enabled": true,
    "show_type_hints": true,
    "show_parameter_hints": true,
    "show_other_hints": true,
    "show_background": false
  },
  "buffer_font_features": {
    "calt": true,
    "liga": true,
    "dlig": true,
    "ss01": true,
    "ss02": true,
    "ss03": true,
    "ss04": true,
    "ss05": true,
    "ss06": true,
    "ss07": true,
    "ss08": true,
    "ss09": true,
    "ss10": true
  },
  "terminal": {
    "font_family": "Monaspace Neon",
    "font_size": 12,
    "line_height": {
      "custom": 1.2
    },
    "cursor_shape": "bar",
    "blinking": "terminal_controlled",
    "minimum_contrast": 0
  },
  "cli_default_open_behavior": "existing_window",
  "diff_view_style": "split",
  "soft_wrap": "bounded",
  "preferred_line_length": 120,
  "tab_size": 4,
  "use_on_type_format": true,
  "show_edit_predictions": false,
  "autosave": {
    "after_delay": {
      "milliseconds": 2000
    }
  },
  "hover_popover_delay": 300,
  "vertical_scroll_margin": 6,
  "mouse_wheel_zoom": true,
  "max_tabs": 10,
  "project_panel": {
    "dock": "left",
    "auto_fold_dirs": false,
    "show_diagnostics": "all",
    "indent_size": 18,
    "indent_guides": {
      "show": "always"
    },
    "scrollbar": {
      "show": "auto",
      "horizontal_scroll": true
    }
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "languages": {
    "Python": {
      "indent_guides": {
        "background_coloring": "indent_aware"
      },
      "language_servers": ["ty", "ruff"]
    },
    "TypeScript": {
      "language_servers": ["tsgo", "biome"],
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    },
    "TSX": {
      "language_servers": ["tsgo", "biome"],
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    },
    "JavaScript": {
      "language_servers": ["tsgo", "biome"],
      "formatter": {
        "language_server": {
          "name": "biome"
        }
      },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      }
    },
    "Java": {
      "language_servers": ["jdtls"]
    }
  },
  "file_types": {
    "tailwindcss": ["*.css"]
  },
  "node": {
    "ignore_system_version": true
  }
}
