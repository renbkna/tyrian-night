{
  "theme": {
    "mode": "system",
    "dark": "Tyrian Night",
    "light": "Tyrian Dawn"
  },
  "buffer_font_family": "Monaspace Neon",
  "buffer_font_size": 15,
  "buffer_font_weight": 450,
  "buffer_line_height": {
    "custom": 1.5
  },
  "buffer_font_features": {
    "calt": true,
    "liga": true,
    "dlig": true,
    "ss01": true,
    "ss02": true,
    "ss03": true,
    "ss04": true,
    "ss05": true,
    "ss06": true,
    "ss07": true,
    "ss08": true,
    "ss09": true,
    "ss10": true
  },
  "ui_font_family": ".SystemUIFont",
  "ui_font_size": 16,
  "ui_font_weight": 400,
  "semantic_tokens": "combined",
  "colorize_brackets": true,
  "indent_guides": {
    "enabled": true,
    "line_width": 1,
    "active_line_width": 1,
    "coloring": "indent_aware",
    "background_coloring": "disabled"
  },
  "terminal": {
    "font_family": "Monaspace Neon",
    "font_size": 14,
    "line_height": {
      "custom": 1.4
    },
    "minimum_contrast": 0
  }
}
