{
  "name": "tyrian-night",
  "displayName": "Tyrian Night",
  "description": "Ultra-saturated Tyrian Night, Dusk, and Dawn themes with built-in Island UI controls",
  "version": "2.0.0",
  "type": "module",
  "publisher": "renbkna",
  "icon": "public/icon.png",
  "engines": {
    "vscode": "^1.118.0"
  },
  "categories": [
    "Themes"
  ],
  "extensionKind": [
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/renbkna/tyrian-night.git"
  },
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "themes": [
      {
        "label": "Tyrian Night",
        "uiTheme": "vs-dark",
        "path": "./themes/tyrian-night.json"
      },
      {
        "label": "Tyrian Dusk",
        "uiTheme": "vs-dark",
        "path": "./themes/tyrian-dusk.json"
      },
      {
        "label": "Tyrian Dawn",
        "uiTheme": "vs",
        "path": "./themes/tyrian-dawn.json"
      }
    ],
    "commands": [
      {
        "command": "tyrianNight.applyIslandUi",
        "title": "Apply Island UI",
        "category": "Tyrian Night"
      },
      {
        "command": "tyrianNight.repairIslandUi",
        "title": "Repair Island UI",
        "category": "Tyrian Night"
      },
      {
        "command": "tyrianNight.restoreClassicUi",
        "title": "Restore Classic UI",
        "category": "Tyrian Night"
      },
      {
        "command": "tyrianNight.doctorIslandUi",
        "title": "Doctor Island UI",
        "category": "Tyrian Night"
      }
    ]
  },
  "scripts": {
    "verify": "bun run check && bun run lint && bun run test && bun run format:check && bun run check:island-css",
    "package:check": "bun run verify && bun run build",
    "build:island-css": "node scripts/islandCss.mjs",
    "check:island-css": "node scripts/islandCss.mjs --check",
    "build": "tsup",
    "watch": "tsup --watch",
    "check": "tsc --noEmit",
    "test": "bun test",
    "lint": "oxlint src/ tests/ scripts/",
    "lint:fix": "oxlint src/ tests/ scripts/ --fix",
    "format": "biome format . --write",
    "format:check": "biome format .",
    "package": "bun run package:check && vsce package --no-dependencies"
  },
  "simple-git-hooks": {
    "pre-commit": "bun run verify"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.14",
    "@types/node": "^22.19.17",
    "@types/vscode": "^1.118.0",
    "@vscode/vsce": "^3.9.1",
    "oxlint": "^1.63.0",
    "simple-git-hooks": "^2.13.1",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3"
  },
  "overrides": {
    "picomatch": "^4.0.4"
  }
}
