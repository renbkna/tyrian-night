{
  "compilerOptions": {
    "module": "NodeNext",
    "target": "ESNext",
    "lib": ["ESNext"],
    "sourceMap": true,
    "rootDir": ".",
    "outDir": "out",
    "strict": true,
    "allowJs": true,
    "checkJs": true,
    "types": ["node"],
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["apps/vscode/src", "scripts"]
}
