  "semanticTokenColors": {
    "*.declaration": {
      "bold": true
    },
    "variable": {
      "role": "variable"
    },
    "parameter": {
      "role": "data"
    },
    "variable.local": {
      "role": "variable"
    },
    "variable.defaultLibrary": {
      "role": "data"
    },
    "variable.readonly": {
      "role": "data"
    },
    "property.readonly": {
      "role": "data"
    },
    "function": {
      "role": "function"
    },
    "function.defaultLibrary": {
      "role": "function"
    },
    "method": {
      "role": "function"
    },
    "class": {
      "role": "type"
    },
    "class.defaultLibrary": {
      "role": "type"
    },
    "interface": {
      "role": "type"
    },
    "type": {
      "role": "type"
    },
    "typeParameter": {
      "role": "type"
    },
    "namespace": {
      "role": "type"
    },
    "enum": {
      "role": "type"
    },
    "enumMember": {
      "role": "data"
    },
    "property": {
      "role": "variable"
    },
    "decorator": {
      "role": "type"
    },
    "macro": {
      "role": "type"
    },
    "regexp": {
      "role": "regexp"
    },
    "keyword": {
      "role": "keyword"
    },
    "operator": {
      "role": "keyword"
    },
    "string": {
      "role": "string"
    },
    "number": {
      "role": "data"
    },
    "comment": {
      "role": "comment"
    },
    "*.readonly": {
      "role": "data"
    },
    "*.deprecated": {
      "role": "data",
      "fontStyle": "strikethrough"
    },
    "*.documentation": {
      "role": "documentation"
    },
    "constructor": {
      "role": "type"
    }
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "role": "comment",
      "fontStyle": "italic"
    },
    {
      "scope": [
        "comment.block.documentation",
        "comment.line.documentation",
        "string.quoted.docstring"
      ],
      "role": "documentation",
      "fontStyle": "italic"
    },
    {
      "scope": [
        "keyword",
        "storage.type",
        "storage.modifier",
        "keyword.operator",
        "keyword.control",
        "keyword.other.import",
        "keyword.control.import",
        "entity.name.tag",
        "entity.name.tag.js",
        "entity.name.tag.css",
        "meta.import"
      ],
      "role": "keyword"
    },
    {
      "scope": ["meta.type.annotation", "meta.annotation", "entity.name.type.annotation"],
      "role": "type",
      "fontStyle": "italic"
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.name.type.class",
        "entity.name.struct",
        "entity.name.enum",
        "entity.name.type.interface",
        "entity.name.interface",
        "support.type",
        "support.class",
        "support.class.component"
      ],
      "role": "type"
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "entity.name.method",
        "variable.function"
      ],
      "role": "function"
    },
    {
      "scope": [
        "variable.parameter",
        "meta.parameter",
        "entity.other.attribute-name",
        "meta.attribute",
        "support.type.property-name.json",
        "constant.character.escape",
        "string.regexp constant.character.escape"
      ],
      "role": "data"
    },
    {
      "scope": ["variable.language"],
      "role": "data",
      "fontStyle": "italic"
    },
    {
      "scope": ["string", "string.quoted", "string.template", "punctuation.definition.string"],
      "role": "string"
    },
    {
      "scope": ["constant.language"],
      "role": "constantLanguage"
    },
    {
      "scope": [
        "constant.numeric",
        "constant.character",
        "constant.other",
        "keyword.other.unit",
        "variable.other.enummember",
        "variable.other.constant",
        "entity.name.constant",
        "support.constant",
        "entity.other.attribute-name.id.css"
      ],
      "role": "data"
    },
    {
      "scope": [
        "variable",
        "variable.other",
        "variable.other.property",
        "meta.object-literal.key",
        "support.variable",
        "support.constant.property-value.css"
      ],
      "role": "variable"
    },
    {
      "scope": ["support.type.property-name.css", "entity.other.attribute-name.class.css"],
      "role": "variable"
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "meta.delimiter",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.definition.tag"
      ],
      "role": "punctuation"
    },
    {
      "scope": ["string.regexp"],
      "role": "regexp"
    },
    {
      "scope": ["entity.name.function.decorator", "meta.decorator", "punctuation.decorator"],
      "role": "type"
    },
    {
      "scope": ["markup.heading", "entity.name.section"],
      "role": "keyword",
      "fontStyle": "bold"
    },
    {
      "scope": ["markup.bold"],
      "role": "variable",
      "fontStyle": "bold"
    },
    {
      "scope": ["markup.italic"],
      "role": "emphasis",
      "fontStyle": "italic"
    },
    {
      "scope": ["markup.inline.raw"],
      "role": "function"
    },
    {
      "scope": ["markup.underline.link"],
      "role": "type"
    },
    {
      "scope": ["markup.quote"],
      "role": "string",
      "fontStyle": "italic"
    },
    {
      "scope": ["markup.deleted", "diff.deleted"],
      "role": "ui:status.removed"
    },
    {
      "scope": ["markup.inserted", "diff.inserted"],
      "role": "ui:status.success"
    },
    {
      "scope": ["markup.changed", "diff.changed"],
      "role": "ui:status.modified"
    },
    {
      "scope": ["markup.strikethrough"],
      "role": "ui:status.modified",
      "fontStyle": "strikethrough"
    },
    {
      "scope": ["invalid"],
      "role": "ui:status.error"
    },
    {
      "scope": ["invalid.deprecated"],
      "role": "data",
      "fontStyle": "strikethrough"
    }
  ],
