    },
    "keyword": {
      "role": "keyword"
    },
    "operator": {
      "role": "keyword"
    },
    "string": {
      "role": "string"
    },
    "number": {
      "role": "data"
    },
    "comment": {
      "role": "comment"
    },
    "*.readonly": {
      "role": "data"
    },
    "*.deprecated": {
      "role": "data",
