{
  "schemaVersion": 6,
  "themeSets": {
    "current": ["tyrian-night", "tyrian-nocturne", "tyrian-pastel", "tyrian-abyss", "tyrian-dawn"],
    "standard-material": ["tyrian-night", "tyrian-pastel", "tyrian-abyss", "tyrian-dawn"],
    "standard-brackets": [
      "tyrian-night",
      "tyrian-pastel",
      "tyrian-abyss",
      "tyrian-dawn",
      "tyrian-night-old"
    ],
    "night": ["tyrian-night"],
    "nocturne": ["tyrian-nocturne"],
    "pastel": ["tyrian-pastel"]
  },
  "roleGroups": {
    "bracket-depths": [
      "brackets:depth1",
      "brackets:depth2",
      "brackets:depth3",
      "brackets:depth4",
      "brackets:depth5",
      "brackets:depth6"
    ],
    "primary-content": [
      "ui:text.primary",
      "syntax:variable",
      "terminal:foreground",
      "terminal:ansi.white"
    ],
    "semantic-content": [
      "syntax:keyword",
      "syntax:type",
      "syntax:function",
      "syntax:string",
      "syntax:data",
      "syntax:regexp"
    ],
    "supporting-content": ["syntax:constantLanguage", "syntax:emphasis", "syntax:file"],
    "quiet-content": [
      "syntax:comment",
      "syntax:documentation",
      "syntax:punctuation",
      "syntax:null"
    ],
    "all-syntax": [
      "syntax:comment",
      "syntax:constantLanguage",
      "syntax:data",
      "syntax:documentation",
      "syntax:emphasis",
      "syntax:file",
      "syntax:function",
      "syntax:keyword",
      "syntax:null",
      "syntax:punctuation",
      "syntax:regexp",
      "syntax:string",
      "syntax:type",
      "syntax:variable"
    ],
    "supporting-ui-text": [
      "ui:text.secondary",
      "ui:text.muted",
      "ui:text.chrome",
      "ui:text.sidebar",
      "ui:text.status"
    ],
    "load-bearing-chromatic-text": [
      "ui:status.error",
      "ui:status.warning",
      "ui:status.info",
      "ui:status.success",
      "terminal:ansi.magenta",
      "terminal:ansi.blue",
      "terminal:ansi.cyan",
      "terminal:ansi.green",
      "terminal:ansi.yellow",
      "terminal:ansi.red"
    ],
    "pastel-carriers": [
      "ui:accent.primary",
      "ui:status.error",
      "ui:status.warning",
      "ui:status.success",
      "ui:status.info",
      "terminal:ansi.red",
      "terminal:ansi.green",
      "terminal:ansi.yellow",
      "terminal:ansi.blue",
      "terminal:ansi.magenta",
      "terminal:ansi.cyan"
    ],
    "status-trio": ["ui:status.success", "ui:status.warning", "ui:status.error"],
    "state-effects": [
      "ui:effect.hoverSurface",
      "ui:effect.activeSurface",
      "ui:effect.checkedSurface",
      "ui:effect.focusSurface",
      "ui:effect.strongAccent"
    ]
  },
  "reference": {
    "background": "ui:surface.canvas",
    "prominenceGroups": [
      "primary-content",
      "semantic-content",
      "supporting-content",
      "quiet-content"
    ],
    "typography": {
      "family": "Monaspace Neon",
      "sizePx": 15,
      "weight": 400,
      "width": 100,
      "slant": 0
    },
    "apca": {
      "mode": "advisory",
      "maximumAbsoluteLcByPolarity": {
        "light-on-dark": 90,
        "dark-on-light": 100
      }
    }
  },
  "constraints": [
    {
      "id": "family-primary-contrast",
      "kind": "contrast-envelope",
      "themeSet": "current",
      "roles": ["ui:text.primary"],
      "minimum": 7
    },
    {
      "id": "family-supporting-ui-contrast",
      "kind": "contrast-envelope",
      "themeSet": "current",
      "roleGroup": "supporting-ui-text",
      "minimum": 4.5
    },
    {
      "id": "family-syntax-contrast",
      "kind": "contrast-envelope",
      "themeSet": "current",
      "roleGroup": "all-syntax",
      "minimum": 4.5
    },
    {
      "id": "family-chromatic-text-contrast",
      "kind": "contrast-envelope",
      "themeSet": "current",
      "roleGroup": "load-bearing-chromatic-text",
      "minimum": 4.5
    },
    {
      "id": "family-text-order",
      "kind": "contrast-order",
      "themeSet": "current",
      "roles": ["ui:text.primary", "ui:text.secondary", "ui:text.muted"],
      "minimumGap": 0.01
    },
    {
      "id": "family-primary-over-chrome",
      "kind": "contrast-order",
      "themeSet": "current",
      "roles": ["ui:text.primary", "ui:text.chrome"],
      "minimumGap": 0.01
    },
    {
      "id": "family-primary-over-sidebar",
      "kind": "contrast-order",
      "themeSet": "current",
      "roles": ["ui:text.primary", "ui:text.sidebar"],
      "minimumGap": 0.01
    },
    {
      "id": "family-primary-over-status",
      "kind": "contrast-order",
      "themeSet": "current",
      "roles": ["ui:text.primary", "ui:text.status"],
      "minimumGap": 0.01
    },
    {
      "id": "family-interactive-label-contrast",
      "kind": "contrast-pairs",
      "themeSet": "current",
      "pairs": [
        ["ui:buttons.foreground", "ui:buttons.background", 4.5],
        ["ui:buttons.foreground", "ui:buttons.hover.background", 4.5],
        ["ui:badges.foreground", "ui:badges.background", 4.5]
      ]
    },
    {
      "id": "family-checked-label-contrast",
      "kind": "contrast-pairs",
      "themeSet": "current",
      "pairs": [["ui:text.primary", "ui:effect.checkedSurface", 4.5]]
    },
    {
      "id": "family-focus-visibility",
      "kind": "contrast-pairs",
      "themeSet": "current",
      "pairs": [
        ["ui:accent.primary", "ui:surface.canvas", 3],
        ["ui:accent.primary", "ui:surface.field", 3],
        ["ui:accent.primary", "ui:surface.raised", 3],
        ["ui:accent.primary", "ui:surface.hover", 3]
      ]
    },
    {
      "id": "family-active-line-visible",
      "kind": "pair-separation",
      "themeSet": "current",
      "left": "ui:editor.activeLineBorder",
      "right": "ui:surface.canvas",
      "minimumOklabDelta": 1
    },
    {
      "id": "family-active-line-distinct",
      "kind": "distinct-colors",
      "themeSet": "current",
      "roles": ["ui:editor.activeLineBorder", "ui:border.default"]
    },
    {
      "id": "family-border-state-order",
      "kind": "contrast-order",
      "themeSet": "current",
      "background": "ui:surface.field",
      "roles": ["ui:accent.primary", "ui:border.hover", "ui:border.default"],
      "minimumGap": 0.01
    },
    {
      "id": "family-border-state-chroma",
      "kind": "chroma-order",
      "themeSet": "current",
      "moreRole": "ui:accent.primary",
      "lessRole": "ui:border.hover",
      "minimumGap": 0.001
    },
    {
      "id": "surface-canvas-navigation",
      "kind": "pair-separation",
      "themeSet": "current",
      "left": "ui:surface.canvas",
      "right": "ui:surface.navigation",
