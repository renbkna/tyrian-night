  "semanticTokenColors": {
    "*.declaration": {
      "bold": true
    },
    "parameter": {
      "foreground": "#9A4F7F",
      "italic": true
    },
    "variable.local": {
      "foreground": "#211727"
    },
    "variable.defaultLibrary": {
      "foreground": "#8F5F1C",
      "bold": true
    },
    "variable.readonly": {
      "foreground": "#8F5F1C"
    },
    "property.readonly": {
      "foreground": "#8F5F1C"
    },
    "function": {
      "foreground": "#933E4B",
      "italic": true
    },
    "function.defaultLibrary": {
      "foreground": "#933E4B"
    },
    "method": {
      "foreground": "#933E4B",
      "italic": true
    },
    "class": {
      "foreground": "#4767A8"
    },
    "class.defaultLibrary": {
      "foreground": "#4767A8"
    },
    "interface": {
      "foreground": "#4767A8"
    },
    "type": {
      "foreground": "#4767A8"
    },
    "typeParameter": {
      "foreground": "#4767A8",
      "italic": true
    },
    "namespace": {
      "foreground": "#7650A8"
    },
    "enum": {
      "foreground": "#4767A8"
    },
    "enumMember": {
      "foreground": "#8F5F1C"
    },
    "property": {
      "foreground": "#211727"
    },
    "decorator": {
      "foreground": "#8F5F1C",
      "italic": true
    },
    "macro": {
      "foreground": "#8F5F1C"
    },
    "regexp": {
      "foreground": "#9A4F7F"
    }
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#766A82",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "comment.block.documentation",
      "settings": {
        "foreground": "#756880",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["string", "string.template", "punctuation.definition.string"],
      "settings": {
        "foreground": "#3D7654"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "entity.name.tag",
        "entity.name.tag.js",
        "entity.name.tag.css",
        "meta.import",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#7650A8"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "keyword.other.unit",
        "variable.other.enummember",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#8F5F1C"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.type.interface",
        "entity.name.type.class",
        "support.type",
        "support.class",
        "support.class.component",
        "entity.other.attribute-name.class.css"
      ],
      "settings": {
        "foreground": "#4767A8"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "entity.name.method",
        "support.type.property-name.css",
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#933E4B",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["variable", "support.constant.property-value.css"],
      "settings": {
        "foreground": "#211727"
      }
    },
    {
      "scope": ["storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#7650A8",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["variable.parameter", "meta.parameter", "entity.other.attribute-name"],
      "settings": {
        "foreground": "#9A4F7F",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["string.regexp", "constant.character.escape"],
      "settings": {
        "foreground": "#9A4F7F"
      }
    },
    {
      "scope": ["variable.language", "entity.name.function.decorator"],
      "settings": {
        "foreground": "#8F5F1C",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.other.constant",
        "meta.decorator",
        "punctuation.decorator",
        "markup.list"
      ],
      "settings": {
        "foreground": "#8F5F1C"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#766A82"
      }
    },
    {
      "scope": "markup.heading",
      "settings": {
        "foreground": "#7650A8",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.bold",
      "settings": {
        "foreground": "#211727",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.italic",
      "settings": {
        "foreground": "#9A4F7F",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.inline.raw",
      "settings": {
        "foreground": "#933E4B"
      }
    },
    {
      "scope": "markup.underline.link",
      "settings": {
        "foreground": "#4767A8"
      }
    },
    {
      "scope": "markup.quote",
      "settings": {
        "foreground": "#3D7654",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "invalid",
      "settings": {
        "foreground": "#AD4750"
      }
    },
    {
      "scope": "invalid.deprecated",
      "settings": {
        "foreground": "#8F5F1C",
        "fontStyle": "strikethrough"
      }
    }
  ]
}
