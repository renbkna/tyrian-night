{
  "$schema": "https://biomejs.dev/schemas/2.4.14/schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "trailingCommas": "es5",
      "semicolons": "always"
    }
  },
  "files": {
    "includes": [
      "**",
      "!.machine-backups/**",
      "!.codex-logs/**",
      "!out/**",
      "!node_modules/**",
      "!*.vsix",
      "!apps/vscode/island/tyrian-*.css",
      "!apps/vscode/themes/**",
      "!apps/zed/themes/tyrian-night.json"
    ]
  }
}
