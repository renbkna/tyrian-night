  "semanticTokenColors": {
    "*.declaration": {
      "bold": true
    },
    "parameter": {
      "foreground": "#C179A8",
      "italic": true
    },
    "variable.local": {
      "foreground": "#D8CEE8"
    },
    "variable.defaultLibrary": {
      "foreground": "#C79A58",
      "bold": true
    },
    "variable.readonly": {
      "foreground": "#C79A58"
    },
    "property.readonly": {
      "foreground": "#C79A58"
    },
    "function": {
      "foreground": "#4B9A9B",
      "italic": true
    },
    "function.defaultLibrary": {
      "foreground": "#4B9A9B"
    },
    "method": {
      "foreground": "#4B9A9B",
      "italic": true
    },
    "class": {
      "foreground": "#7288C8"
    },
    "class.defaultLibrary": {
      "foreground": "#7288C8"
    },
    "interface": {
      "foreground": "#7288C8"
    },
    "type": {
      "foreground": "#7288C8"
    },
    "typeParameter": {
      "foreground": "#7288C8",
      "italic": true
    },
    "namespace": {
      "foreground": "#A06FD0"
    },
    "enum": {
      "foreground": "#7288C8"
    },
    "enumMember": {
      "foreground": "#C79A58"
    },
    "property": {
      "foreground": "#D8CEE8"
    },
    "decorator": {
      "foreground": "#C79A58",
      "italic": true
    },
    "macro": {
      "foreground": "#C79A58"
    },
    "regexp": {
      "foreground": "#C179A8"
    }
  },
  "tokenColors": [
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": {
        "foreground": "#8A829A",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "comment.block.documentation",
      "settings": {
        "foreground": "#9085A0",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["string", "string.template", "punctuation.definition.string"],
      "settings": {
        "foreground": "#5A946D"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "keyword.operator",
        "entity.name.tag",
        "entity.name.tag.js",
        "entity.name.tag.css",
        "meta.import",
        "keyword.control.import"
      ],
      "settings": {
        "foreground": "#A06FD0"
      }
    },
    {
      "scope": [
        "constant.numeric",
        "constant.language",
        "constant.character",
        "keyword.other.unit",
        "variable.other.enummember",
        "entity.other.attribute-name.id.css"
      ],
      "settings": {
        "foreground": "#C79A58"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.type.interface",
        "entity.name.type.class",
        "support.type",
        "support.class",
        "support.class.component",
        "entity.other.attribute-name.class.css"
      ],
      "settings": {
        "foreground": "#7288C8"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call",
        "entity.name.method",
        "support.type.property-name.css",
        "support.type.property-name.json"
      ],
      "settings": {
        "foreground": "#4B9A9B",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["variable", "support.constant.property-value.css"],
      "settings": {
        "foreground": "#D8CEE8"
      }
    },
    {
      "scope": ["storage.type", "storage.modifier"],
      "settings": {
        "foreground": "#A06FD0",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["variable.parameter", "meta.parameter", "entity.other.attribute-name"],
      "settings": {
        "foreground": "#C179A8",
        "fontStyle": "italic"
      }
    },
    {
      "scope": ["string.regexp", "constant.character.escape"],
      "settings": {
        "foreground": "#C179A8"
      }
    },
    {
      "scope": ["variable.language", "entity.name.function.decorator"],
      "settings": {
        "foreground": "#C79A58",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "variable.other.constant",
        "meta.decorator",
        "punctuation.decorator",
        "markup.list"
      ],
      "settings": {
        "foreground": "#C79A58"
      }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#8B8098"
      }
    },
    {
      "scope": "markup.heading",
      "settings": {
        "foreground": "#A06FD0",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.bold",
      "settings": {
        "foreground": "#D8CEE8",
        "fontStyle": "bold"
      }
    },
    {
      "scope": "markup.italic",
      "settings": {
        "foreground": "#C179A8",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "markup.inline.raw",
      "settings": {
        "foreground": "#4B9A9B"
      }
    },
    {
      "scope": "markup.underline.link",
      "settings": {
        "foreground": "#7288C8"
      }
    },
    {
      "scope": "markup.quote",
      "settings": {
        "foreground": "#5A946D",
        "fontStyle": "italic"
      }
    },
    {
      "scope": "invalid",
      "settings": {
        "foreground": "#C97378"
      }
    },
    {
      "scope": "invalid.deprecated",
      "settings": {
        "foreground": "#C79A58",
        "fontStyle": "strikethrough"
      }
    }
  ]
}
